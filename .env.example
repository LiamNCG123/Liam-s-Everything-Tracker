# ── Supabase (frontend) ───────────────────────────────────────────────────────
# Find these at: Supabase dashboard → Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Supabase (backend API routes) ─────────────────────────────────────────────
# Service role key is secret — never expose to the browser
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Sync (legacy token-based, to be replaced by Supabase Auth) ────────────────
VITE_SYNC_ENABLED=false
VITE_SYNC_WRITE_TOKEN=
SYNC_WRITE_TOKEN=
SYNC_USER_ID=personal
