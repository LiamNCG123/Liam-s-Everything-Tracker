# ── Supabase ──────────────────────────────────────────────────────────────────
# Find these at: Supabase dashboard → Settings → API
# VITE_SUPABASE_URL is the same value as SUPABASE_URL (just needs both prefixes)
SUPABASE_URL=
VITE_SUPABASE_URL=          # same value as SUPABASE_URL above
VITE_SUPABASE_ANON_KEY=     # "anon / public" key — safe to expose to browser
SUPABASE_SERVICE_ROLE_KEY=  # secret — server-side only, never expose to browser

# ── Sync (legacy token-based, to be replaced by Supabase Auth) ────────────────
VITE_SYNC_ENABLED=false
VITE_SYNC_WRITE_TOKEN=
SYNC_WRITE_TOKEN=
SYNC_USER_ID=personal
